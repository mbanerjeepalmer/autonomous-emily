# Caddyfile template — bootstrap substitutes __DESKTOP_PUBLIC_HOST__ and __FRAME_ANCESTORS__
__DESKTOP_PUBLIC_HOST__ {
	encode gzip

	header {
		Content-Security-Policy "frame-ancestors __FRAME_ANCESTORS__"
		-X-Frame-Options
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}

	# Cookie bootstrap: /enter?token=JWT → Set-Cookie → redirect to vnc.html
	handle /enter* {
		reverse_proxy 127.0.0.1:8091
	}

	handle {
		forward_auth 127.0.0.1:8091 {
			uri /validate
			copy_headers Remote-User
		}
		reverse_proxy 127.0.0.1:6080
	}
}
