#!/bin/bash
# noVNC / websockify bound to localhost only — public access goes through Caddy + JWT.
set -euo pipefail

NOVNC_ROOT="${NOVNC_ROOT:-/usr/share/novnc}"
PORT="${NOVNC_PORT:-6080}"
VNC_TARGET="${VNC_TARGET:-127.0.0.1:5901}"
bind_ip="127.0.0.1"

if [[ -x /usr/share/novnc/utils/novnc_proxy ]]; then
  exec /usr/share/novnc/utils/novnc_proxy \
    --listen "${bind_ip}:${PORT}" \
    --vnc "${VNC_TARGET}" \
    --web "${NOVNC_ROOT}"
fi

if command -v websockify >/dev/null 2>&1; then
  exec websockify --web="${NOVNC_ROOT}" "${bind_ip}:${PORT}" "${VNC_TARGET}"
fi

echo "noVNC / websockify not found" >&2
exit 1
