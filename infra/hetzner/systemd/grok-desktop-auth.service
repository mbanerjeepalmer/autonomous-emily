[Unit]
Description=Desktop JWT auth validator for Caddy forward_auth
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-/etc/grok-desktop.env
ExecStart=/usr/bin/python3 /usr/local/lib/grok-desktop/auth_validate.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
