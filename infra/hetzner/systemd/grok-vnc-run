#!/bin/bash
# Long-running TigerVNC wrapper for systemd Type=simple.
set -euo pipefail

export HOME="${HOME:-/home/grok}"
export USER="${USER:-grok}"
cd "$HOME"

vncserver -kill :1 >/dev/null 2>&1 || true
rm -f /tmp/.X1-lock /tmp/.X11-unix/X1 "$HOME"/.vnc/*.pid 2>/dev/null || true

vncserver :1 -localhost yes -geometry 1920x1080 -depth 24 -SecurityTypes None

while pgrep -u "$USER" -f 'Xtigervnc :1' >/dev/null; do
  sleep 5
done
exit 1
