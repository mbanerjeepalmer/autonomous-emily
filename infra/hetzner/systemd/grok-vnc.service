[Unit]
Description=TigerVNC desktop for Grok Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__DESKTOP_USER__
Group=__DESKTOP_USER__
Environment=HOME=/home/__DESKTOP_USER__
Environment=USER=__DESKTOP_USER__
WorkingDirectory=/home/__DESKTOP_USER__
ExecStart=/usr/local/bin/grok-vnc-run
ExecStop=/usr/bin/vncserver -kill :1
Restart=on-failure
RestartSec=5
KillMode=control-group

[Install]
WantedBy=multi-user.target
