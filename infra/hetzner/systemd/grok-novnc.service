[Unit]
Description=noVNC web client for Grok Bot desktop
After=grok-vnc.service network-online.target
Requires=grok-vnc.service
Wants=network-online.target

[Service]
Type=simple
User=__DESKTOP_USER__
Group=__DESKTOP_USER__
Environment=HOME=/home/__DESKTOP_USER__
ExecStart=/usr/local/bin/grok-novnc-start
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
