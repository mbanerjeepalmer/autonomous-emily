# Required for the live "Live marketplace scan" agent on /results
# (app/api/discover, lib/agent/discoveryAgent.ts). Not needed to run the
# rest of the prototype, which is entirely hard-coded data.
TAVILY_API_KEY=
OPENROUTER_API_KEY=

# Optional: OpenRouter model id used by the discovery agent (default: openai/gpt-4o-mini)
DISCOVERY_AGENT_MODEL=

# Shared / Hetzner (infra) — never commit .env
HCLOUD_TOKEN=
SSH_PUBLIC_KEY_PATH=~/.ssh/id_ed25519.pub
DESKTOP_USER=grok
DESKTOP_PUBLIC_HOST=desktop.autonoemily.world
DESKTOP_JWT_SECRET=
TAILSCALE_AUTH_KEY=
# SSH_ALLOW_CIDR=

# apps/web /desktop and /invoke (formerly apps/control)
APP_GATE_PASSWORD=
SESSION_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000
GROK_BOT_WEBHOOK_URL=
GROK_BOT_WEBHOOK_KEY=
# Optional server-to-server invoke (Authorization: Bearer …)
EMILY_INVOKE_SECRET=
