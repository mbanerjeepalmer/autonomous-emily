# Required for the live "Live marketplace scan" agent on /results
# (app/api/discover, lib/agent/discoveryAgent.ts). Not needed to run the
# rest of the prototype, which is entirely hard-coded data.
TAVILY_API_KEY=
OPENROUTER_API_KEY=

# Optional: OpenRouter model id used by the discovery agent (default: openai/gpt-4o-mini)
DISCOVERY_AGENT_MODEL=
